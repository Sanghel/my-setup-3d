{
  "name": "my-setup-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=15000",
    "test:watch": "vitest --maxWorkers=2",
    "preview": "vite preview",
    "assets": "npm run assets:build -- --bake && npm run assets:optimize && npm run assets:lightmap",
    "assets:preview": "npm run assets:build -- --preview && npm run assets:optimize",
    "assets:build": "blender --background --factory-startup --python blender/scripts/build_room.py -- --out public/models/room.raw.glb",
    "assets:optimize": "gltf-transform optimize public/models/room.raw.glb public/models/room.glb --compress meshopt --texture-compress webp --texture-size 2048 --flatten false --join false --simplify false --palette false --prune-attributes false && node scripts/asset-sizes.mjs",
    "textures:fetch": "node scripts/fetch-textures.mjs",
    "textures": "npm run textures:fetch && bash blender/textures/process.sh",
    "textures:photos": "node scripts/process-photos.mjs",
    "textures:screens": "node scripts/render-screens.mjs",
    "assets:final": "npm run assets:build -- --bake --final && npm run assets:optimize && npm run assets:lightmap",
    "assets:lightmap": "node scripts/encode-lightmap.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
